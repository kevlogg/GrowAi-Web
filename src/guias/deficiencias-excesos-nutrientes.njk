<!-- Script interactivo de filtrado de síntomas -->
<script>
  (function() {
    const locSelect = document.getElementById('locationSelect');
    const symSelect = document.getElementById('symptomSelect');
    const cards = document.querySelectorAll('.nutrient-card');
    const alertEl = document.getElementById('diagnosticAlert');

    function filterCards() {
      const loc = locSelect.value;
      const sym = symSelect.value;
      let visibleCount = 0;

      cards.forEach(card => {
        const cardLocs = card.dataset.location.split(' ');
        const cardSyms = card.dataset.symptoms.split(' ');

        const matchLoc = (loc === 'all') || cardLocs.includes(loc);
        const matchSym = (sym === 'all') || cardSyms.includes(sym);

        if (matchLoc && matchSym) {
          card.style.display = 'block';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (loc === 'bottom') {
        alertEl.innerHTML = '<strong class="text-green">Nutriente Móvil detectado:</strong> Si el problema está abajo, la planta está canibalizando hojas viejas. Los sospechosos principales son <span class="text-green-soft font-bold">Nitrógeno (N), Fósforo (P), Potasio (K) o Magnesio (Mg)</span>.';
      } else if (loc === 'top') {
        alertEl.innerHTML = '<strong class="text-purple">Nutriente Inmóvil detectado:</strong> Si el daño está en los brotes recién nacidos, la planta no puede transportar el elemento fijado. Sospechosos principales: <span class="text-purple font-bold">Calcio (Ca), Hierro (Fe) o Boro (B)</span>.';
      } else {
        alertEl.innerHTML = '<strong class="text-green-soft">Tip botánico:</strong> Si ves puntas curvadas o manchas amarillas, contrastá la localización (abajo vs arriba) para descartar el 80% de los errores.';
      }
    }

    locSelect.addEventListener('change', filterCards);
    symSelect.addEventListener('change', filterCards);
  })();
</script>
