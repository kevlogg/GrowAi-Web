<!-- Lógica Interactiva en JavaScript Puro -->
<script>
  (function() {
    const lightWattsInput = document.getElementById('lightWatts');
    const lightWattsDisplay = document.getElementById('lightWattsDisplay');
    const lightHoursInput = document.getElementById('lightHours');
    const extractorWattsInput = document.getElementById('extractorWatts');
    const extractorHoursInput = document.getElementById('extractorHours');
    const fanWattsInput = document.getElementById('fanWatts');
    const fanHoursInput = document.getElementById('fanHours');
    const extraWattsInput = document.getElementById('extraWatts');
    const extraHoursInput = document.getElementById('extraHours');
    const kwhRateInput = document.getElementById('kwhRate');
    const rateDisplay = document.getElementById('rateDisplay');

    // Outputs
    const monthlyCostEl = document.getElementById('monthlyCost');
    const dailyCostEl = document.getElementById('dailyCost');
    const dailyKwhEl = document.getElementById('dailyKwh');
    const monthlyKwhEl = document.getElementById('monthlyKwh');
    const cycleCostEl = document.getElementById('cycleCost');
    const barLight = document.getElementById('barLight');
    const barVent = document.getElementById('barVent');
    const barExtra = document.getElementById('barExtra');
    const lightPct = document.getElementById('lightPct');
    const ventPct = document.getElementById('ventPct');
    const extraPct = document.getElementById('extraPct');
    const rowExtra = document.getElementById('rowExtra');
    const copyReportBtn = document.getElementById('copyReportBtn');

    function calculate() {
      const lightW = parseFloat(lightWattsInput.value) || 0;
      const lightH = parseFloat(lightHoursInput.value) || 18;
      const extW = parseFloat(extractorWattsInput.value) || 0;
      const extH = parseFloat(extractorHoursInput.value) || 24;
      const fanW = parseFloat(fanWattsInput.value) || 0;
      const fanH = parseFloat(fanHoursInput.value) || 24;
      const extExtraW = parseFloat(extraWattsInput.value) || 0;
      const extExtraH = parseFloat(extraHoursInput.value) || 0;
      const rate = parseFloat(kwhRateInput.value) || 130;

      // Diarios en kWh
      const lightDailyKwh = (lightW * lightH) / 1000;
      const ventDailyKwh = ((extW * extH) + (fanW * fanH)) / 1000;
      const extraDailyKwh = (extExtraW * extExtraH) / 1000;
      const totalDailyKwh = lightDailyKwh + ventDailyKwh + extraDailyKwh;

      const monthlyKwh = totalDailyKwh * 30;
      const monthlyCost = monthlyKwh * rate;
      const dailyCost = totalDailyKwh * rate;

      // Ciclo completo (4 sem vege a 18h + 9 sem flora a 12h)
      // Vegetativo: 28 días con luz a 18h
      const lightVegeKwh = ((lightW * 18) / 1000) * 28;
      const ventVegeKwh = ventDailyKwh * 28;
      const extraVegeKwh = extraDailyKwh * 28;

      // Floración: 63 días con luz a 12h
      const lightFloraKwh = ((lightW * 12) / 1000) * 63;
      const ventFloraKwh = ventDailyKwh * 63;
      const extraFloraKwh = extraDailyKwh * 63;

      const totalCycleKwh = lightVegeKwh + ventVegeKwh + extraVegeKwh + lightFloraKwh + ventFloraKwh + extraFloraKwh;
      const cycleCost = totalCycleKwh * rate;

      // Actualizar DOM
      lightWattsDisplay.textContent = lightW + ' W';
      rateDisplay.textContent = '$ ' + rate + ' / kWh';
      dailyKwhEl.textContent = totalDailyKwh.toFixed(2) + ' kWh';
      monthlyKwhEl.textContent = monthlyKwh.toFixed(1) + ' kWh';
      dailyCostEl.textContent = '$ ' + Math.round(dailyCost).toLocaleString('es-AR');
      monthlyCostEl.textContent = '$ ' + Math.round(monthlyCost).toLocaleString('es-AR');
      cycleCostEl.textContent = '$ ' + Math.round(cycleCost).toLocaleString('es-AR');

      // Barras porcentuales
      if (totalDailyKwh > 0) {
        const pLight = Math.round((lightDailyKwh / totalDailyKwh) * 100);
        const pVent = Math.round((ventDailyKwh / totalDailyKwh) * 100);
        const pExtra = Math.max(0, 100 - pLight - pVent);

        barLight.style.width = pLight + '%';
        barVent.style.width = pVent + '%';
        barExtra.style.width = pExtra + '%';

        lightPct.textContent = pLight + '%';
        ventPct.textContent = pVent + '%';
        extraPct.textContent = pExtra + '%';

        if (extraDailyKwh > 0) {
          rowExtra.style.display = 'flex';
        } else {
          rowExtra.style.display = 'none';
        }
      }
    }

    // Event listeners
    lightWattsInput.addEventListener('input', calculate);
    extractorWattsInput.addEventListener('input', calculate);
    extractorHoursInput.addEventListener('change', calculate);
    fanWattsInput.addEventListener('input', calculate);
    fanHoursInput.addEventListener('change', calculate);
    extraWattsInput.addEventListener('input', calculate);
    extraHoursInput.addEventListener('change', calculate);
    kwhRateInput.addEventListener('input', calculate);

    // Presets de lámparas
    document.querySelectorAll('.preset-light').forEach(btn => {
      btn.addEventListener('click', function() {
        document.querySelectorAll('.preset-light').forEach(b => {
          b.classList.remove('border-green', 'bg-green/20', 'text-green', 'font-bold');
          b.classList.add('border-green/30', 'text-green-soft');
        });
        this.classList.remove('border-green/30', 'text-green-soft');
        this.classList.add('border-green', 'bg-green/20', 'text-green', 'font-bold');
        lightWattsInput.value = this.dataset.val;
        calculate();
      });
    });

    // Presets de fotoperiodo
    document.querySelectorAll('.fotope-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        document.querySelectorAll('.fotope-btn').forEach(b => {
          b.classList.remove('border-green', 'bg-green/20', 'text-green', 'font-bold');
          b.classList.add('border-green/30', 'text-text-main/70', 'font-medium');
        });
        this.classList.remove('border-green/30', 'text-text-main/70', 'font-medium');
        this.classList.add('border-green', 'bg-green/20', 'text-green', 'font-bold');
        lightHoursInput.value = this.dataset.hours;
        calculate();
      });
    });

    // Presets de tarifas
    document.querySelectorAll('.rate-preset').forEach(btn => {
      btn.addEventListener('click', function() {
        document.querySelectorAll('.rate-preset').forEach(b => {
          b.classList.remove('border-green', 'bg-green/20', 'text-green', 'font-bold');
          b.classList.add('border-green/20', 'text-text-main/70');
        });
        this.classList.remove('border-green/20', 'text-text-main/70');
        this.classList.add('border-green', 'bg-green/20', 'text-green', 'font-bold');
        kwhRateInput.value = this.dataset.rate;
        calculate();
      });
    });

    // Copiar reporte
    copyReportBtn.addEventListener('click', function() {
      const summary = `📊 *Reporte de Consumo Indoor - GrowAI*\n` +
        `• Iluminación: ${lightWattsInput.value}W (${lightHoursInput.value}h/día)\n` +
        `• Consumo diario: ${dailyKwhEl.textContent}\n` +
        `• Consumo mensual: ${monthlyKwhEl.textContent}\n` +
        `• Costo estimado mensual: ${monthlyCostEl.textContent}\n` +
        `• Costo ciclo completo (13 sem): ${cycleCostEl.textContent}\n` +
        `Calculado con: https://www.growai.com.ar/herramientas/calculadora-consumo-electrico/`;

      navigator.clipboard.writeText(summary).then(() => {
        const originalText = copyReportBtn.innerHTML;
        copyReportBtn.innerHTML = '✅ ¡Copiado al portapapeles!';
        copyReportBtn.classList.add('bg-green/20', 'text-green');
        setTimeout(() => {
          copyReportBtn.innerHTML = originalText;
          copyReportBtn.classList.remove('bg-green/20', 'text-green');
        }, 2500);
      });
    });

    // Inicializar
    calculate();
  })();
</script>

