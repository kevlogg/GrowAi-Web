<!-- Lógica de cálculo -->
<script>
  (function() {
    const tentWInput = document.getElementById('tentW');
    const tentDInput = document.getElementById('tentD');
    const tentHInput = document.getElementById('tentH');
    const areaDisplay = document.getElementById('areaDisplay');
    const potSizeDisplay = document.getElementById('potSizeDisplay');

    const potCountEl = document.getElementById('potCount');
    const distributionTextEl = document.getElementById('distributionText');
    const totalSubstrateEl = document.getElementById('totalSubstrate');
    const bagSuggestionEl = document.getElementById('bagSuggestion');
    const recommendedLedEl = document.getElementById('recommendedLed');
    const recommendedCfmEl = document.getElementById('recommendedCfm');

    let currentLiters = 10;
    let currentTech = 'tradicional';

    function calculate() {
      const w = parseFloat(tentWInput.value) || 80;
      const d = parseFloat(tentDInput.value) || 80;
      const h = parseFloat(tentHInput.value) || 180;

      const areaM2 = (w * d) / 10000;
      areaDisplay.textContent = `${w} × ${d} cm · ${areaM2.toFixed(2)} m²`;
      potSizeDisplay.textContent = `${currentLiters} Litros`;

      // Calcular cantidad de macetas según técnica y m2
      let plants = 4;
      let dist = 'Matriz recomendada: 2 × 2';

      if (currentTech === 'sog') {
        // Sea of Green: ~16 a 25 plantas por m2
        plants = Math.max(4, Math.round(areaM2 * 18));
      } else if (currentTech === 'scrog') {
        // SCROG: 1 a 4 plantas por m2
        plants = Math.max(1, Math.round(areaM2 * 3));
      } else {
        // Tradicional
        if (currentLiters <= 5) {
          plants = Math.round(areaM2 * 12);
        } else if (currentLiters <= 11) {
          plants = Math.round(areaM2 * 6);
        } else {
          plants = Math.round(areaM2 * 3);
        }
        plants = Math.max(1, plants);
      }

      // Distribución visual
      const sqrt = Math.round(Math.sqrt(plants));
      const cols = sqrt;
      const rows = Math.ceil(plants / cols);
      dist = `Distribución aproximada: ${cols} × ${rows} filas`;

      // Sustrato con 10% por compactación de riego
      const baseSubstrate = plants * currentLiters;
      const totalSubstrate = Math.round(baseSubstrate * 1.1);

      // Bolsas recomendadas (bolsas de 50L y 20L)
      let bagsText = '';
      if (totalSubstrate <= 25) {
        bagsText = '1 bolsa de 20L o 25L';
      } else if (totalSubstrate <= 55) {
        bagsText = '1 bolsa grande de 50L';
      } else if (totalSubstrate <= 80) {
        bagsText = '1 bolsa de 50L + 1 de 20L';
      } else {
        const bags50 = Math.ceil(totalSubstrate / 50);
        bagsText = `${bags50} bolsas de 50L`;
      }

      // Potencia LED recomendada (300W - 400W por m2)
      const minW = Math.round(areaM2 * 300);
      const maxW = Math.round(areaM2 * 400);

      // Extracción de aire: Volumen m3 * 60 renovaciones/hora * 1.3 factor filtro
      const volumeM3 = (w * d * h) / 1000000;
      const minCfm = Math.round(volumeM3 * 60 * 1.3);

      // Update DOM
      potCountEl.textContent = plants;
      distributionTextEl.textContent = dist;
      totalSubstrateEl.textContent = totalSubstrate + ' Litros';
      bagSuggestionEl.textContent = bagsText;
      recommendedLedEl.textContent = `${minW}W - ${maxW}W reales`;
      recommendedCfmEl.textContent = `${minCfm} m³/h`;
    }

    tentWInput.addEventListener('input', calculate);
    tentDInput.addEventListener('input', calculate);
    tentHInput.addEventListener('input', calculate);

    // Presets carpa
    document.querySelectorAll('.preset-tent').forEach(btn => {
      btn.addEventListener('click', function() {
        document.querySelectorAll('.preset-tent').forEach(b => {
          b.classList.remove('border-green', 'bg-green/20', 'text-green', 'font-bold');
          b.classList.add('border-green/30', 'text-green-soft');
        });
        this.classList.remove('border-green/30', 'text-green-soft');
        this.classList.add('border-green', 'bg-green/20', 'text-green', 'font-bold');

        tentWInput.value = this.dataset.w;
        tentDInput.value = this.dataset.d;
        tentHInput.value = this.dataset.h;
        calculate();
      });
    });

    // Técnica
    document.querySelectorAll('.tech-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        document.querySelectorAll('.tech-btn').forEach(b => {
          b.classList.remove('border-green', 'bg-green/20', 'text-green', 'font-bold');
          b.classList.add('border-green/20', 'text-text-main/70');
        });
        this.classList.remove('border-green/20', 'text-text-main/70');
        this.classList.add('border-green', 'bg-green/20', 'text-green', 'font-bold');
        currentTech = this.dataset.tech;
        calculate();
      });
    });

    // Litros
    document.querySelectorAll('.pot-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        document.querySelectorAll('.pot-btn').forEach(b => {
          b.classList.remove('border-green', 'bg-green/20', 'text-green', 'font-bold');
          b.classList.add('border-green/30', 'text-green-soft');
        });
        this.classList.remove('border-green/30', 'text-green-soft');
        this.classList.add('border-green', 'bg-green/20', 'text-green', 'font-bold');
        currentLiters = parseInt(this.dataset.liters, 10);
        calculate();
      });
    });

    calculate();
  })();
</script>

