<!-- Script de cálculo de psicrometría -->
<script>
  (function() {
    const tempInput = document.getElementById('tempInput');
    const tempDisplay = document.getElementById('tempDisplay');
    const rhInput = document.getElementById('rhInput');
    const rhDisplay = document.getElementById('rhDisplay');
    const offsetInput = document.getElementById('offsetInput');
    const offsetDisplay = document.getElementById('offsetDisplay');

    const vpdValueEl = document.getElementById('vpdValue');
    const statusBadgeEl = document.getElementById('statusBadge');
    const gaugePointer = document.getElementById('gaugePointer');
    const recommendationText = document.getElementById('recommendationText');
    const leafTempCalc = document.getElementById('leafTempCalc');
    const targetRangeCalc = document.getElementById('targetRangeCalc');

    let currentStage = 'vege';

    const stageTargets = {
      clon:        { min: 0.4, max: 0.8, label: '0.4 - 0.8 kPa' },
      vege:        { min: 0.8, max: 1.1, label: '0.8 - 1.1 kPa' },
      flora_early: { min: 1.0, max: 1.3, label: '1.0 - 1.3 kPa' },
      flora_late:  { min: 1.2, max: 1.5, label: '1.2 - 1.5 kPa' }
    };

    function calculateVPD() {
      const Tair = parseFloat(tempInput.value);
      const RH = parseFloat(rhInput.value);
      const offset = parseFloat(offsetInput.value);
      const Tleaf = Tair + offset;

      // Ecuación de Magnus-Tetens:
      // SVP = 0.61078 * exp((17.27 * T) / (T + 237.3)) en kPa
      const svpAir = 0.61078 * Math.exp((17.27 * Tair) / (Tair + 237.3));
      const svpLeaf = 0.61078 * Math.exp((17.27 * Tleaf) / (Tleaf + 237.3));
      const avpAir = svpAir * (RH / 100);

      const vpd = Math.max(0, svpLeaf - avpAir);

      // Render
      tempDisplay.textContent = Tair.toFixed(1) + ' °C';
      rhDisplay.textContent = RH + ' %';
      offsetDisplay.textContent = (offset > 0 ? '+' : '') + offset.toFixed(1) + ' °C';
      leafTempCalc.textContent = Tleaf.toFixed(1) + ' °C';

      vpdValueEl.textContent = vpd.toFixed(2);

      // Posición del medidor (0 kPa a 2.0 kPa mapeado a 0% - 100%)
      const gaugePct = Math.min(100, Math.max(0, (vpd / 2.0) * 100));
      gaugePointer.style.left = gaugePct + '%';

      // Evaluación según etapa
      const target = stageTargets[currentStage];
      targetRangeCalc.textContent = target.label;

      if (vpd < 0.35) {
        statusBadgeEl.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-blue-500/20 text-blue-400 border border-blue-500/30';
        statusBadgeEl.innerHTML = '<span class="w-2 h-2 rounded-full bg-blue-400"></span> Peligro: Aire Demasiado Saturado';
        recommendationText.textContent = 'El aire tiene tanta humedad que la planta no puede evaporar agua. Riesgo muy alto de condensación foliar, falta de transporte de calcio y hongos. Subí la ventilación/extracción o baja la humedad.';
      } else if (vpd < target.min) {
        statusBadgeEl.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-sky-500/20 text-sky-300 border border-sky-500/30';
        statusBadgeEl.innerHTML = '<span class="w-2 h-2 rounded-full bg-sky-300"></span> VPD Bajo (Transpiración Lenta)';
        recommendationText.textContent = `Para esta etapa tu objetivo es ${target.label}. La planta transpira poco. Aumentá levemente la temperatura de la sala o reducí la humedad unos 5-10% para acelerar el metabolismo.`;
      } else if (vpd <= target.max) {
        statusBadgeEl.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-green/20 text-green border border-green/30';
        statusBadgeEl.innerHTML = '<span class="w-2 h-2 rounded-full bg-green animate-pulse"></span> Zona Óptima de Crecimiento';
        recommendationText.textContent = `¡Excelente! Estás dentro de la ventana perfecta (${target.label}). Los estomas permanecen abiertos al 100%, absorbiendo CO2 y transportando agua y sales minerales de manera ideal.`;
      } else if (vpd <= target.max + 0.3) {
        statusBadgeEl.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30';
        statusBadgeEl.innerHTML = '<span class="w-2 h-2 rounded-full bg-amber-300"></span> VPD Ligeramente Alto';
        recommendationText.textContent = `El aire está algo seco para la etapa actual. La planta empieza a protegerse cerrando parcialmente los estomas. Si podés, humedecé el ambiente o bajá un poco la temperatura.`;
      } else {
        statusBadgeEl.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-red-500/20 text-red-400 border border-red-500/30';
        statusBadgeEl.innerHTML = '<span class="w-2 h-2 rounded-full bg-red-400"></span> Peligro: Estrés Hídrico Severo';
        recommendationText.textContent = 'El ambiente está excesivamente seco y caliente. Las hojas pierden agua a un ritmo destructivo, provocando quemaduras apicales y cierre total de estomas. Necesitás humidificar de urgencia.';
      }
    }

    tempInput.addEventListener('input', calculateVPD);
    rhInput.addEventListener('input', calculateVPD);
    offsetInput.addEventListener('input', calculateVPD);

    // Selección de etapas
    document.querySelectorAll('.stage-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        document.querySelectorAll('.stage-btn').forEach(b => {
          b.classList.remove('border-green', 'bg-green/20', 'text-green', 'font-bold');
          b.classList.add('border-green/20', 'text-text-main/70');
        });
        this.classList.remove('border-green/20', 'text-text-main/70');
        this.classList.add('border-green', 'bg-green/20', 'text-green', 'font-bold');
        currentStage = this.dataset.stage;
        calculateVPD();
      });
    });

    calculateVPD();
  })();
</script>
